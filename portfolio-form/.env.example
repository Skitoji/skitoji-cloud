# iCloud SMTP (custom domain skitoji.cloud)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
# Apple ID email used to log into iCloud (NOT the Apple ID login alias)
SMTP_USER=
# App-specific password (account.apple.com -> Sign-In & Security -> App-Specific Passwords)
SMTP_PASS=
# Where submissions land / who they appear from
MAIL_TO=
MAIL_FROM=
# Discord webhook (optional notification channel)
DISCORD_WEBHOOK_URL=
